<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/on_surface"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="CleanBrowsing Family Filter Enforcement"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardServiceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/service_status_inactive"
                android:textColor="@color/accent_red"
                android:textStyle="bold"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnableService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_enable_service"
                android:backgroundTint="@color/accent_blue"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/cardServiceStatus">

        <TextView
            android:id="@+id/tvStepPrivateDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_step_item"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:text="1. Private DNS: Pending"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/tvStepWifiDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_step_item"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:text="2. Wi-Fi DNS: Pending"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/tvStepChromeDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_step_item"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:text="3. Chrome DoH: Pending"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/tvStepBraveDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_step_item"
            android:padding="12dp"
            android:text="4. Brave DoH: Pending"
            android:textColor="@color/on_surface" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartAutomation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="@string/btn_start_automation"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="@color/secondary"
        android:textColor="@android:color/white"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSteps" />

    <TextView
        android:id="@+id/tvLogOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="@color/surface"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_secondary"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:text="System ready.\nEnable Accessibility Service and press start."
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnStartAutomation" />

</androidx.constraintlayout.widget.ConstraintLayout>
